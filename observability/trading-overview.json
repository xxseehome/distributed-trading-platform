{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (symbol) (rate(trading_orders_accepted_total{environment=\"production\"}[$__rate_interval]))", "legendFormat": "accepted {{symbol}}"}
      ],
      "title": "Order acceptance rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum by (reason) (rate(trading_orders_rejected_total{environment=\"production\"}[$__rate_interval]))", "legendFormat": "rejected {{reason}}"}
      ],
      "title": "Order rejection rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 7},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(trading_order_acceptance_seconds_bucket{environment=\"production\"}[$__rate_interval])))", "legendFormat": "p95"}
      ],
      "title": "Acceptance latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 7},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"},
      "targets": [
        {"expr": "1 - (sum(rate(trading_orders_rejected_total{environment=\"production\"}[$__rate_interval])) / clamp_min(sum(rate(trading_orders_accepted_total{environment=\"production\"}[$__rate_interval])) + sum(rate(trading_orders_rejected_total{environment=\"production\"}[$__rate_interval])), 1))", "legendFormat": "acceptance availability"}
      ],
      "title": "Acceptance availability (experimental SLO)",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 14},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "sum(kube_pod_status_ready{namespace=\"production\", condition=\"true\"})", "legendFormat": "ready pods"},
        {"expr": "count(kube_pod_info{namespace=\"production\"})", "legendFormat": "total pods"}
      ],
      "title": "Production pod readiness",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 14},
      "id": 6,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"},
      "targets": [
        {"expr": "sum(up{namespace=\"production\"})", "legendFormat": "scrape targets"}
      ],
      "title": "Production scrape targets",
      "type": "stat"
    }
  ],
  "schemaVersion": 39,
  "tags": ["trading", "sre", "local-experiment"],
  "templating": {"list": [{"current": {"selected": true, "text": "Prometheus", "value": "Prometheus"}, "label": "Data source", "name": "datasource", "query": "prometheus", "type": "datasource"}]},
  "time": {"from": "now-1h", "to": "now"},
  "title": "Trading Overview",
  "uid": "trading-overview-local",
  "version": 1
}
